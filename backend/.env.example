# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Client Application URLs (CORS Security)
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=flatmate_admin
DB_PASSWORD=flatmate_secret_password
DB_NAME=flatmate_db

# Prisma Connection URL
# For local machine execution:
DATABASE_URL="postgresql://flatmate_admin:flatmate_secret_password@localhost:5432/flatmate_db?schema=public"
# For Docker Compose execution:
# DATABASE_URL="postgresql://flatmate_admin:flatmate_secret_password@postgres:5432/flatmate_db?schema=public"

# Authentication & Security (JWT)
JWT_ACCESS_SECRET=flatmate_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=flatmate_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting (Security Checklist #11)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Profile & Lifestyle Rules (Configurable limits)
MAX_PROFILE_PHOTOS=6
MIN_PROFILE_AGE=18
MAX_PROFILE_INTERESTS=20

