datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum DocumentType {
  GOVT_ID
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  COLLEGE_ID
  EMPLOYMENT_ID
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum SleepSchedule {
  EARLY_BIRD
  NIGHT_OWL
  FLEXIBLE
}

enum CleanlinessLevel {
  VERY_CLEAN
  MODERATE
  RELAXED
}

enum SocialPreference {
  INTROVERT
  EXTROVERT
  AMBIVERT
  OCCASIONAL_GUESTS
}

enum FoodPreference {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGGETARIAN
}

enum WorkSchedule {
  WORK_FROM_HOME
  OFFICE
  HYBRID
  STUDENT
}

enum HabitPreference {
  NEVER
  OUTSIDE_ONLY
  OCCASIONALLY
  REGULAR
}

enum PetPreference {
  LOVES_PETS
  NO_PETS
  HAS_PET
}

enum PrivacyPreference {
  HIGH
  MODERATE
  LOW
}

enum ConversationType {
  DIRECT_MATCH
  GROUP_RENT
}

enum MemberRole {
  MEMBER
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
  EXPENSE_ALERT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum RentGroupStatus {
  ACTIVE
  ARCHIVED
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  WIFI
  GROCERIES
  MAINTENANCE
  MAID_COOK
  OTHER
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT_AMOUNT
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  IN_APP_GATEWAY
}

enum PaymentStatus {
  INITIATED
  PENDING_VERIFICATION
  COMPLETED
  FAILED
  REFUNDED
}

enum ReportCategory {
  HARASSMENT
  FAKE_PROFILE
  SCAM_OR_FRAUD
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_MATCH
  NEW_MESSAGE
  EXPENSE_ADDED
  RENT_REMINDER
  VERIFICATION_UPDATE
  SYSTEM_ALERT
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum SecurityEventType {
  LOGIN_FAILED
  RATE_LIMIT_EXCEEDED
  UNAUTHORIZED_ACCESS_ATTEMPT
  TOKEN_REPLAY_ATTEMPT
  SUSPICIOUS_LOCATION_LOGIN
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PHONE_VERIFY
  EMAIL_VERIFY
  PASSWORD_RESET
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  email               String?            @unique
  phoneNumber         String?            @unique
  passwordHash        String?
  isEmailVerified     Boolean            @default(false)
  isPhoneVerified     Boolean            @default(false)
  status              UserStatus         @default(ACTIVE)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  profile             UserProfile?
  refreshTokens       RefreshToken[]
  verifications       UserVerification[]
  sentLikes           Like[]                @relation("SentLikes")
  receivedLikes       Like[]                @relation("ReceivedLikes")
  savedProfiles       SavedProfile[]        @relation("UserSavedProfiles")
  savedByProfiles     SavedProfile[]        @relation("TargetSavedProfiles")
  matchesAsUser1      Match[]               @relation("MatchUser1")
  matchesAsUser2      Match[]               @relation("MatchUser2")
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  rentGroupMembers    RentGroupMember[]
  createdRentGroups   RentGroup[]           @relation("CreatedRentGroups")
  paidExpenses        Expense[]             @relation("PaidExpenses")
  expenseSplits       ExpenseSplit[]
  sentPayments        Payment[]             @relation("PayerPayments")
  receivedPayments    Payment[]             @relation("PayeePayments")
  reportsFiled        Report[]              @relation("ReporterReports")
  reportsAgainst      Report[]              @relation("ReportedUserReports")
  blockedUsers        BlockedUser[]         @relation("BlockerUsers")
  blockedByUsers      BlockedUser[]         @relation("BlockedTargetUsers")
  notifications       Notification[]
  auditLogs           AuditLog[]
  securityEvents      SecurityEvent[]

  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id          String     @id @default(uuid()) @db.Uuid
  identifier  String
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  expiresAt   DateTime
  resendAfter DateTime
  isUsed      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([identifier])
  @@index([expiresAt])
}

model UserVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  documentType       DocumentType
  documentNumberHash String?
  documentUrl        String
  status             VerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedById       String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy         AdminUser?         @relation("VerifiedByAdmin", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// -------------------------------------------------------------
// PROFILE & PREFERENCES
// -------------------------------------------------------------

model UserProfile {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @db.Uuid
  displayName       String
  dateOfBirth       DateTime
  gender            Gender
  bio               String?               @db.Text
  occupation        String?
  companyOrCollege  String?
  budgetMin         Int
  budgetMax         Int
  city              String
  preferredLocality String?
  moveInDate        DateTime?
  isComplete        Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos            UserPhoto[]
  location          UserLocation?
  lifestyle         LifestylePreferences?
  interests         UserInterest[]

  @@index([city])
  @@index([budgetMin, budgetMax])
  @@index([gender])
}

model UserPhoto {
  id        String      @id @default(uuid()) @db.Uuid
  profileId String      @db.Uuid
  url       String
  order     Int         @default(0)
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())

  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserLocation {
  id        String      @id @default(uuid()) @db.Uuid
  profileId String      @unique @db.Uuid
  latitude  Float
  longitude Float
  cityName  String
  areaName  String?
  updatedAt DateTime    @updatedAt

  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@index([cityName])
}

model LifestylePreferences {
  id                 String            @id @default(uuid()) @db.Uuid
  profileId          String            @unique @db.Uuid
  sleepSchedule      SleepSchedule     @default(FLEXIBLE)
  cleanliness        CleanlinessLevel  @default(MODERATE)
  socialPreference   SocialPreference  @default(AMBIVERT)
  foodPreference     FoodPreference    @default(VEGETARIAN)
  workSchedule       WorkSchedule      @default(HYBRID)
  smokingPreference  HabitPreference   @default(NEVER)
  drinkingPreference HabitPreference   @default(NEVER)
  petPreference      PetPreference     @default(NO_PETS)
  privacyPreference  PrivacyPreference @default(MODERATE)
  nonNegotiables     String[]          @default([])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  profile            UserProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserInterest {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @db.Uuid
  interestName String
  category     String?

  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, interestName])
  @@index([interestName])
}

// -------------------------------------------------------------
// DISCOVERY, LIKES & MATCHES
// -------------------------------------------------------------

model Like {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @db.Uuid
  receiverId String   @db.Uuid
  isPass     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentLikes", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedLikes", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model SavedProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  savedUserId String   @db.Uuid
  notes       String?
  createdAt   DateTime @default(now())

  user        User     @relation("UserSavedProfiles", fields: [userId], references: [id], onDelete: Cascade)
  savedUser   User     @relation("TargetSavedProfiles", fields: [savedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, savedUserId])
  @@index([userId])
}

model Match {
  id                 String        @id @default(uuid()) @db.Uuid
  user1Id            String        @db.Uuid
  user2Id            String        @db.Uuid
  compatibilityScore Float
  budgetMatch        Float?
  lifestyleMatch     Float?
  locationMatch      Float?
  isActive           Boolean       @default(true)
  unmatchedAt        DateTime?
  unmatchedById      String?       @db.Uuid
  createdAt          DateTime      @default(now())

  user1              User          @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2              User          @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation       Conversation?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([compatibilityScore])
}

// -------------------------------------------------------------
// CHAT & MESSAGING
// -------------------------------------------------------------

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  matchId       String?              @unique @db.Uuid
  rentGroupId   String?              @unique @db.Uuid
  type          ConversationType     @default(DIRECT_MATCH)
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  match         Match?               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rentGroup     RentGroup?           @relation(fields: [rentGroupId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  userId            String       @db.Uuid
  role              MemberRole   @default(MEMBER)
  lastReadMessageId String?      @db.Uuid
  joinedAt          DateTime     @default(now())
  leftAt            DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  content        String        @db.Text
  messageType    MessageType   @default(TEXT)
  attachmentUrl  String?
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// -------------------------------------------------------------
// RENT GROUPS & EXPENSES
// -------------------------------------------------------------

model RentGroup {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  propertyAddress  String?
  totalMonthlyRent Decimal           @db.Decimal(12, 2)
  currency         String            @default("INR")
  createdById      String            @db.Uuid
  status           RentGroupStatus   @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdBy        User              @relation("CreatedRentGroups", fields: [createdById], references: [id], onDelete: Restrict)
  members          RentGroupMember[]
  expenses         Expense[]
  payments         Payment[]
  conversation     Conversation?

  @@index([createdById])
  @@index([status])
}

model RentGroupMember {
  id              String    @id @default(uuid()) @db.Uuid
  groupId         String    @db.Uuid
  userId          String    @db.Uuid
  customRentShare Decimal?  @db.Decimal(12, 2)
  percentageShare Float?
  isGroupAdmin    Boolean   @default(false)
  joinedAt        DateTime  @default(now())

  group           RentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  groupId     String          @db.Uuid
  title       String
  category    ExpenseCategory @default(OTHER)
  totalAmount Decimal         @db.Decimal(12, 2)
  paidById    String          @db.Uuid
  splitType   SplitType       @default(EQUAL)
  dueDate     DateTime?
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  group       RentGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User            @relation("PaidExpenses", fields: [paidById], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
  payments    Payment[]

  @@index([groupId])
  @@index([paidById])
}

model ExpenseSplit {
  id         String    @id @default(uuid()) @db.Uuid
  expenseId  String    @db.Uuid
  userId     String    @db.Uuid
  amountOwed Decimal   @db.Decimal(12, 2)
  isSettled  Boolean   @default(false)
  settledAt  DateTime?

  expense    Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  groupId              String?       @db.Uuid
  expenseId            String?       @db.Uuid
  payerId              String        @db.Uuid
  payeeId              String        @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("INR")
  paymentMethod        PaymentMethod @default(UPI)
  transactionReference String?       @unique
  status               PaymentStatus @default(INITIATED)
  verifiedAt           DateTime?
  notes                String?
  createdAt            DateTime      @default(now())

  group                RentGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense              Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payer                User          @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Restrict)
  payee                User          @relation("PayeePayments", fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
}

// -------------------------------------------------------------
// TRUST, SAFETY & SOCIAL CONTROL
// -------------------------------------------------------------

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedTargetUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id              String         @id @default(uuid()) @db.Uuid
  reporterId      String         @db.Uuid
  reportedUserId  String?        @db.Uuid
  category        ReportCategory
  description     String         @db.Text
  evidenceUrls    String[]       @default([])
  status          ReportStatus   @default(OPEN)
  resolvedById    String?        @db.Uuid
  resolutionNotes String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reporter        User           @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User?          @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedBy      AdminUser?     @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// -------------------------------------------------------------
// RBAC, AUDIT & SECURITY
// -------------------------------------------------------------

model AdminUser {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  fullName        String
  isActive        Boolean            @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  roles           AdminRole[]
  auditLogs       AuditLog[]
  verifications   UserVerification[] @relation("VerifiedByAdmin")
  resolvedReports Report[]           @relation("ResolvedReports")

  @@index([email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?

  adminUsers  AdminRole[]
  permissions RolePermission[]
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  action   String
  resource String

  roles    RolePermission[]

  @@unique([action, resource])
}

model AdminRole {
  adminId String    @db.Uuid
  roleId  String    @db.Uuid

  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role    Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @db.Uuid
  actorType  ActorType @default(USER)
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  userId     String?   @db.Uuid
  adminId    String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SecurityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  eventType      SecurityEventType
  severity       EventSeverity     @default(MEDIUM)
  userId         String?           @db.Uuid
  ipAddress      String
  endpoint       String?
  payloadSummary Json?
  createdAt      DateTime          @default(now())

  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
}
